{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@mirante/shared": ["./packages/shared/src/index.ts"],
      "@mirante/daemon": ["./apps/daemon/src/index.ts"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts"
  ]
}
